# datatype:
# - name: recno
#   datatype: int32
#   description: Record number assigned by the VizieR team. Should Not be used for identification.
#   meta: !!omap
#   - {ucd: meta.record}
#   - {width: 8}
#   - links:
#     - {href: 'http://vizier.cds.unistra.fr/viz-bin/VizieR-5?-info=XML&-out.add=.&-source=I/264/fk6_1&recno=${recno}'}
# - name: FK6
#   datatype: int32
#   description: FK6 number of the star (identical with its FK5 number)
#   meta: !!omap
#   - {ucd: meta.id;meta.main}
#   - {width: 5}
# - name: FK5
#   datatype: string
#   description: Display the FK5 data for this star.
#   meta: !!omap
#   - {ucd: meta.ref}
#   - {_votable_string_dtype: char}
# - name: HIP
#   datatype: int32
#   description: Hipparcos (<I/239>) number of the star
#   meta: !!omap
#   - {ucd: meta.id}
#   - {width: 6}
# - name: Simbad
#   datatype: string
#   description: Simbad column added by the CDS
#   meta: !!omap
#   - {ucd: meta.ref}
#   - {_votable_string_dtype: char}
# - name: Name
#   datatype: string
#   description: Name of the star
#   meta: !!omap
#   - {ucd: meta.id}
#   - links:
#     - {href: 'http://vizier.cds.unistra.fr/viz-bin/VizieR-5?-info=XML&-out.add=.&-source=I/264/fk6_1&recno=${recno}'}
#   - {_votable_string_dtype: char}
#   - {_votable_arraysize: 19*}
# - name: RA_ICRS_
#   datatype: string
#   description: Right ascension (ICRS, Ep=J2000) (G1)
#   meta: !!omap
#   - {ucd: pos.eq.ra;meta.main}
#   - {xtype: hms}
#   - {_votable_string_dtype: char}
# - name: DE_ICRS_
#   datatype: string
#   description: Declination (ICRS, Ep=J2000) (G1)
#   meta: !!omap
#   - {ucd: pos.eq.dec;meta.main}
#   - {xtype: dms}
#   - {_votable_string_dtype: char}
# - name: pmRA_
#   unit: mas / yr
#   datatype: float64
#   format: '{:9.2f}'
#   description: Proper motion in right ascension (SI mode) (pmRA* = mu_alpha*cos(delta)) (G1)
#   meta: !!omap
#   - {ucd: pos.pm;pos.eq.ra}
#   - {width: 9}
#   - {precision: '2'}
# - name: pmDE
#   unit: mas / yr
#   datatype: float64
#   format: '{:9.2f}'
#   description: Proper motion in declination (G1)
#   meta: !!omap
#   - {ucd: pos.pm;pos.eq.dec}
#   - {width: 9}
#   - {precision: '2'}
# - name: TRA
#   unit: yr
#   datatype: float32
#   format: '{:7.2f}'
#   description: Central epoch in RA of the star (SI mode)
#   meta: !!omap
#   - {ucd: time.epoch}
#   - {width: 7}
#   - {precision: '2'}
# - name: e_RA_
#   unit: mas
#   datatype: float32
#   format: '{:5.2f}'
#   description: rms uncertainty on alpha*cos(delta) at the central epoch TRA (SI mode)
#   meta: !!omap
#   - {ucd: stat.error}
#   - {width: 5}
#   - {precision: '2'}
# - name: e_pmRA_
#   unit: mas / yr
#   datatype: float32
#   format: '{:5.2f}'
#   description: rms uncertainty on pmRA* (SI mode)
#   meta: !!omap
#   - {ucd: stat.error}
#   - {width: 5}
#   - {precision: '2'}
# - name: TDE
#   unit: yr
#   datatype: float32
#   format: '{:7.2f}'
#   description: Central epoch in DE of the star (SI mode)
#   meta: !!omap
#   - {ucd: time.epoch}
#   - {width: 7}
#   - {precision: '2'}
# - name: e_DEs
#   unit: mas
#   datatype: float32
#   format: '{:5.2f}'
#   description: rms uncertainty on DE at the central epoch TDE (SI mode)
#   meta: !!omap
#   - {ucd: stat.error}
#   - {width: 5}
#   - {precision: '2'}
# - name: e_pmDE
#   unit: mas / yr
#   datatype: float32
#   format: '{:5.2f}'
#   description: rms uncertainty on pm DE (SI mode)
#   meta: !!omap
#   - {ucd: stat.error}
#   - {width: 5}
#   - {precision: '2'}
