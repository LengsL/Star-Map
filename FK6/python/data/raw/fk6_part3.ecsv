# %ECSV 1.0
# ---
# datatype:
# - name: recno
#   datatype: int32
#   description: Record number assigned by the VizieR team. Should Not be used for identification.
#   meta: !!omap
#   - {ucd: meta.record}
#   - {width: 8}
#   - links:
#     - {href: 'http://vizier.cds.unistra.fr/viz-bin/VizieR-5?-info=XML&-out.add=.&-source=I/264/fk6_3&recno=${recno}'}
# - name: FK6
#   datatype: int32
#   description: FK6 number of the star (identical with its FK5 number)
#   meta: !!omap
#   - {ucd: meta.id;meta.main}
#   - {width: 5}
# - name: FK5
#   datatype: string
#   description: Display the FK5 data for this star.
#   meta: !!omap
#   - {ucd: meta.ref}
#   - {_votable_string_dtype: char}
# - name: HIP
#   datatype: int32
#   description: Hipparcos (<I/239>) number of the star
#   meta: !!omap
#   - {ucd: meta.id}
#   - {width: 6}
# - name: Simbad
#   datatype: string
#   description: Simbad column added by the CDS
#   meta: !!omap
#   - {ucd: meta.ref}
#   - {_votable_string_dtype: char}
# - name: Flag
#   datatype: string
#   description: Flag for the subsample of FK6(III) stars (1)
#   meta: !!omap
#   - {ucd: meta.code}
#   - {_votable_string_dtype: char}
# - name: Name
#   datatype: string
#   description: Name of the star
#   meta: !!omap
#   - {ucd: meta.id}
#   - links:
#     - {href: 'http://vizier.cds.unistra.fr/viz-bin/VizieR-5?-info=XML&-out.add=.&-source=I/264/fk6_3&recno=${recno}'}
#   - {_votable_string_dtype: char}
#   - {_votable_arraysize: 19*}
# - name: RA_ICRS_
#   datatype: string
#   description: Right ascension (ICRS, Ep=J2000) (G1)
#   meta: !!omap
#   - {ucd: pos.eq.ra;meta.main}
#   - {xtype: hms}
#   - {_votable_string_dtype: char}
# - name: DE_ICRS_
#   datatype: string
#   description: Declination (ICRS, Ep=J2000) (G1)
#   meta: !!omap
#   - {ucd: pos.eq.dec;meta.main}
#   - {xtype: dms}
#   - {_votable_string_dtype: char}
# - name: pmRA_
#   unit: mas / yr
#   datatype: float64
#   format: '{:9.2f}'
#   description: Proper motion in right ascension (pmRA* = mu_alpha*cos(delta)) (G1)
#   meta: !!omap
#   - {ucd: pos.pm;pos.eq.ra}
#   - {width: 9}
#   - {precision: '2'}
# - name: pmDE
#   unit: mas / yr
#   datatype: float64
#   format: '{:9.2f}'
#   description: Proper motion in declination (G1)
#   meta: !!omap
#   - {ucd: pos.pm;pos.eq.dec}
#   - {width: 9}
#   - {precision: '2'}
# - name: TRA
#   unit: yr
#   datatype: float32
#   format: '{:7.2f}'
#   description: Central epoch in RA of the star (SI mode)
#   meta: !!omap
#   - {ucd: time.epoch}
#   - {width: 7}
#   - {precision: '2'}
# - name: e_RA_
#   unit: mas
#   datatype: float32
#   format: '{:5.2f}'
#   description: rms uncertainty on alpha*cos(delta) at the central epoch TRA (SI mode)
#   meta: !!omap
#   - {ucd: stat.error}
#   - {width: 5}
#   - {precision: '2'}
# - name: e_pmRA_
#   unit: mas / yr
#   datatype: float32
#   format: '{:5.2f}'
#   description: rms uncertainty on pmRA* (SI mode)
#   meta: !!omap
#   - {ucd: stat.error}
#   - {width: 5}
#   - {precision: '2'}
# - name: TDE
#   unit: yr
#   datatype: float32
#   format: '{:7.2f}'
#   description: Central epoch in DE of the star (SI mode)
#   meta: !!omap
#   - {ucd: time.epoch}
#   - {width: 7}
#   - {precision: '2'}
# - name: e_DEs
#   unit: mas
#   datatype: float32
#   format: '{:5.2f}'
#   description: rms uncertainty on DE at the central epoch TDE (SI mode)
#   meta: !!omap
#   - {ucd: stat.error}
#   - {width: 5}
#   - {precision: '2'}
# - name: e_pmDE
#   unit: mas / yr
#   datatype: float32
#   format: '{:5.2f}'
#   description: rms uncertainty on pmDE (SI mode)
#   meta: !!omap
#   - {ucd: stat.error}
#   - {width: 5}
#   - {precision: '2'}
# - name: plx
#   unit: mas
#   datatype: float32
#   format: '{:5.1f}'
#   description: Resulting parallax of the star (G3)
#   meta: !!omap
#   - {ucd: pos.parallax.trig}
#   - {width: 5}
#   - {precision: '1'}
# - name: e_plx
#   unit: mas
#   datatype: float32
#   format: '{:5.2f}'
#   description: rms uncertainty on plx
#   meta: !!omap
#   - {ucd: stat.error}
#   - {width: 5}
#   - {precision: '2'}
# - name: f_plx
#   datatype: string
#   description: '[HP] Parallax origin, H=Hipparcos (G4)'
#   meta: !!omap
#   - {ucd: meta.code.error}
#   - {_votable_string_dtype: char}
# - name: RV
#   unit: km / s
#   datatype: float64
#   format: '{:8.1f}'
#   description: '? Radial velocity, used in calculating the foreshortening effect'
#   meta: !!omap
#   - {ucd: phys.veloc;pos.heliocentric}
#   - {width: 8}
#   - {precision: '1'}
#   - values: {'null': .nan}
# - name: Vmag
#   unit: mag
#   datatype: float32
#   format: '{:5.2f}'
#   description: Apparent visual magnitude of the star (taken from the HIPPARCOS Catalogue)
#   meta: !!omap
#   - {ucd: phot.mag;em.opt.V}
#   - {width: 5}
#   - {precision: '2'}
# - name: f_Vmag
#   datatype: uint8
#   description: '[1/3]? Variability flag, from Hipparcos (G5)'
#   meta: !!omap
#   - {ucd: meta.code.error}
#   - {width: 1}
#   - values: {'null': 255}
# - name: Kbin1
#   datatype: int16
#   description: Double-star nature of the object flag (G6)
#   meta: !!omap
#   - {ucd: meta.code.multip}
#   - {width: 2}
# - name: Kbin2
#   datatype: uint8
#   description: '? Double-star nature from pm differences (G7)'
#   meta: !!omap
#   - {ucd: meta.code.multip}
#   - {width: 1}
#   - values: {'null': 255}
# - name: Kae
#   datatype: uint8
#   description: '? Astrometrically excellent star flag (G8)'
#   meta: !!omap
#   - {ucd: meta.code.qual}
#   - {width: 1}
#   - values: {'null': 255}
# - name: DpmRA_LTP
#   unit: mas / yr
#   datatype: float64
#   format: '{:8.2f}'
#   description: Difference in proper motion in RA between long-term prediction (LTP) and SI mode
#   meta: !!omap
#   - {ucd: stat.fit.residual}
#   - {width: 8}
#   - {precision: '2'}
# - name: DpmRA_STP
#   unit: mas / yr
#   datatype: float64
#   format: '{:8.2f}'
#   description: Difference in proper motion in RA between short-term prediction (STP) and SI mode
#   meta: !!omap
#   - {ucd: stat.fit.residual}
#   - {width: 8}
#   - {precision: '2'}
# - name: DpmRA_HIP
#   unit: mas / yr
#   datatype: float64
#   format: '{:8.2f}'
#   description: Difference in proper motion in RA between HIP and SI mode
#   meta: !!omap
#   - {ucd: stat.fit.residual}
#   - {width: 8}
#   - {precision: '2'}
# - name: DpmRA_FK5
#   unit: mas / yr
#   datatype: float64
#   format: '{:8.2f}'
#   description: Difference in proper motion in RA between FK5 and SI mode
#   meta: !!omap
#   - {ucd: stat.fit.residual}
#   - {width: 8}
#   - {precision: '2'}
# - name: DpmRA_mu0
#   unit: mas / yr
#   datatype: float64
#   format: '{:8.2f}'
#   description: Difference in proper motion in RA between mu0 and SI mode
#   meta: !!omap
#   - {ucd: stat.fit.residual}
#   - {width: 8}
#   - {precision: '2'}
# - name: DpmDE_LTP
#   unit: mas / yr
#   datatype: float64
#   format: '{:8.2f}'
#   description: Difference in proper motion in DE between long-term prediction (LTP) and SI mode
#   meta: !!omap
#   - {ucd: stat.fit.residual}
#   - {width: 8}
#   - {precision: '2'}
# - name: DpmDE_STP
#   unit: mas / yr
#   datatype: float64
#   format: '{:8.2f}'
#   description: Difference in proper motion in DE between short-term prediction (STP) and SI mode
#   meta: !!omap
#   - {ucd: stat.fit.residual}
#   - {width: 8}
#   - {precision: '2'}
# - name: DpmDE_HIP
#   unit: mas / yr
#   datatype: float64
#   format: '{:8.2f}'
#   description: Difference in proper motion in DE between HIP and SI mode
#   meta: !!omap
#   - {ucd: stat.fit.residual}
#   - {width: 8}
#   - {precision: '2'}
# - name: DpmDE_FK5
#   unit: mas / yr
#   datatype: float64
#   format: '{:8.2f}'
#   description: Difference in proper motion in DE between FK5 and SI mode
#   meta: !!omap
#   - {ucd: stat.fit.residual}
#   - {width: 8}
#   - {precision: '2'}
# - name: DpmDE_mu0
#   unit: mas / yr
#   datatype: float64
#   format: '{:8.2f}'
#   description: Difference in proper motion in DE between mu0 and SI mode
#   meta: !!omap
#   - {ucd: stat.fit.residual}
#   - {width: 8}
#   - {precision: '2'}
# - name: e_DpmRA_LTP
#   unit: mas / yr
#   datatype: float32
#   format: '{:5.2f}'
#   description: rms uncertainty on DpmRA*LTP
#   meta: !!omap
#   - {ucd: stat.error}
#   - {width: 5}
#   - {precision: '2'}
# - name: e_DpmRA_STP
#   unit: mas / yr
#   datatype: float32
#   format: '{:5.2f}'
#   description: rms uncertainty on DpmRA*STP
#   meta: !!omap
#   - {ucd: stat.error}
#   - {width: 5}
#   - {precision: '2'}
# - name: e_DpmRA_HIP
#   unit: mas / yr
#   datatype: float32
#   format: '{:5.2f}'
#   description: rms uncertainty on DpmRA*HIP
#   meta: !!omap
#   - {ucd: stat.error}
#   - {width: 5}
#   - {precision: '2'}
# - name: e_DpmRA_FK5
#   unit: mas / yr
#   datatype: float32
#   format: '{:5.2f}'
#   description: rms uncertainty on DpmRA*FK5
#   meta: !!omap
#   - {ucd: stat.error}
#   - {width: 5}
#   - {precision: '2'}
# - name: e_DpmRA_mu0
#   unit: mas / yr
#   datatype: float32
#   format: '{:5.2f}'
#   description: rms uncertainty on DpmRA*mu0
#   meta: !!omap
#   - {ucd: stat.error}
#   - {width: 5}
#   - {precision: '2'}
# - name: e_DpmDE_LTP
#   unit: mas / yr
#   datatype: float32
#   format: '{:5.2f}'
#   description: rms uncertainty on DpmDELTP
#   meta: !!omap
#   - {ucd: stat.error}
#   - {width: 5}
#   - {precision: '2'}
# - name: e_DpmDE_STP
#   unit: mas / yr
#   datatype: float32
#   format: '{:5.2f}'
#   description: rms uncertainty on DpmDESTP
#   meta: !!omap
#   - {ucd: stat.error}
#   - {width: 5}
#   - {precision: '2'}
# - name: e_DpmDE_HIP
#   unit: mas / yr
#   datatype: float32
#   format: '{:5.2f}'
#   description: rms uncertainty on DpmDEHIP
#   meta: !!omap
#   - {ucd: stat.error}
#   - {width: 5}
#   - {precision: '2'}
# - name: e_DpmDE_FK5
#   unit: mas / yr
#   datatype: float32
#   format: '{:5.2f}'
#   description: rms uncertainty on DpmDEFK5
#   meta: !!omap
#   - {ucd: stat.error}
#   - {width: 5}
#   - {precision: '2'}
# - name: e_DpmDE_mu0
#   unit: mas / yr
#   datatype: float32
#   format: '{:5.2f}'
#   description: rms uncertainty on DpmDEmu0
#   meta: !!omap
#   - {ucd: stat.error}
#   - {width: 5}
#   - {precision: '2'}
# - name: FFH
#   datatype: float32
#   format: '{:5.2f}'
#   description: F parameter based on FK5/HIP data (G11)
#   meta: !!omap
#   - {ucd: stat.fit.goodness}
#   - {width: 5}
#   - {precision: '2'}
# - name: F0H
#   datatype: float32
#   format: '{:5.2f}'
#   description: F parameter based on FK5/HIP data (G11)
#   meta: !!omap
#   - {ucd: stat.fit.goodness}
#   - {width: 5}
#   - {precision: '2'}
# - name: F0_GC_H
#   datatype: float32
#   format: '{:5.2f}'
#   description: '? F parameter based on GC/HIP data (G11)'
#   meta: !!omap
#   - {ucd: stat.fit.goodness}
#   - {width: 5}
#   - {precision: '2'}
#   - values: {'null': .nan}
# - name: F0F
#   datatype: float32
#   format: '{:5.2f}'
#   description: F parameter based on Fk5/HIP data (G11)
#   meta: !!omap
#   - {ucd: stat.fit.goodness}
#   - {width: 5}
#   - {precision: '2'}
# - name: FTH
